{
  "name": "gkg-website",
  "version": "0.1.0",
  "private": true,
  "description": "Neue Website des Gleitschirmklubs Glarnerland (GKG)",
  "scripts": {
    "previews": "node tools/render-previews.js",
    "prototype": "node tools/build-prototype.js",
    "check": "node --test backend/wetter.test.js && node tools/build-prototype.js && node tools/check-prototype.js",
    "serve": "node tools/build-prototype.js && node tools/serve.js",
    "tiles": "python3 tools/build-tiles.py",
    "karte": "python3 tools/fetch-overture.py && python3 tools/build-mapdata.py && node tools/build-routes.js && python3 tools/build-tiles.py",
    "poster": "node tools/build-prototype.js && node tools/render-map-poster.js",
    "test:backend": "node --test backend/wetter.test.js",
    "spots": "node tools/export-spots.js"
  },
  "devDependencies": {
    "maplibre-gl": "^5.24.0",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
